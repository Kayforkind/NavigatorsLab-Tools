// Cloudflare deployment for https://navigatorslab.com/tools/
// Usage: npm run build, then stage dist/ under deploy/ and copy worker.js:
//   mkdir -p deploy && cp -r dist deploy/tools && cp wrangler.tools.jsonc deploy/wrangler.jsonc && cp worker.js deploy/ && cp src/lib/mcp.ts deploy/
//   cd deploy && npx wrangler deploy
// worker.js runs first for every request (run_worker_first), stamps the
// security headers onto each response, serves the MCP endpoint at /tools/mcp
// (bundling mcp.ts), and maps /llms.txt to the suite's agent docs.
{
  // account_id is public routing info (not a credential) - pinned so scoped deploy tokens skip the account-list API
  "account_id": "56faf9a57ad29af2d943fdedfb5ecda9",
  "name": "navigatorslab-tools",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "routes": [
    { "pattern": "navigatorslab.com/tools", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/tools/*", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/llms.txt", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/llms-full.txt", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/status", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/status.html", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/QR-Studio", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/Photo-Privacy-Kit", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/Metadata-Checker", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/Image-Shrinker", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/Scan-Cleaner", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/E-Sign-Pad", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/Receipts-to-PDF", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/Receipt-OCR", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/Audio-Trimmer", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/Invoice-Generator", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/Batch-Rename", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/Print-Shop-Prep", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/PDF-Pages", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/Text-Diff", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/Text-Stats", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/qr", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/exif", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/metadata", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/shrink", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/scan", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/sign", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/receipts", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/ocr", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/audio", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/invoice", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/rename", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/printprep", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/pdfpages", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/textdiff", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/textstats", "zone_name": "navigatorslab.com" }
  ]
}

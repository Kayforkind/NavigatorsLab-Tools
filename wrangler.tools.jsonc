// Cloudflare deployment for https://navigatorslab.com/tools/
// Usage: npm run build, then stage dist/ under deploy/ and copy worker.js:
//   mkdir -p deploy && cp -r dist deploy/tools && cp wrangler.tools.jsonc deploy/wrangler.jsonc && cp worker.js deploy/
//   cd deploy && npx wrangler deploy
// worker.js runs first for every request (run_worker_first) and stamps the
// security headers onto each response before it leaves the edge.
{
  "account_id": "56faf9a57ad29af2d943fdedfb5ecda9",
  "name": "navigatorslab-tools",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "routes": [
    { "pattern": "navigatorslab.com/tools", "zone_name": "navigatorslab.com" },
    { "pattern": "navigatorslab.com/tools/*", "zone_name": "navigatorslab.com" }
  ]
}
